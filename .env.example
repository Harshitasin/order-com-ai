@'
# Copy to .env and fill in real values.  NEVER commit .env (it is in .gitignore).
# Avoid quotes and $ characters in passwords (the Docker init script reads them).

# ---------------------------------------------------------------- database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=shop

# chatbot tools (SELECT only)
DB_RO_USER=assistant_ro
DB_RO_PASS=

# audit logging (INSERT only). Optional locally; without it only logs/chat_log.jsonl is written.
DB_AUDIT_USER=audit_writer
DB_AUDIT_PASS=

# login (reads 3 columns of customers). Needed for /login.
DB_AUTH_USER=auth_reader
DB_AUTH_PASS=

# ---------------------------------------------------------------- security
# generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# ---------------------------------------------------------------- LLM (Groq)
# Free API key (no credit card): https://console.groq.com/keys
GROQ_API_KEY=
# Optional. Must be a Groq model that supports tool use. Model names change over time:
# check https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-120b

# ---------------------------------------------------------------- misc
# Docker only (and scripts/seed_data.py, which otherwise asks for the root password)
MYSQL_ROOT_PASSWORD=

# set to false only for local load tests
RATE_LIMIT_ENABLED=true

# set to true only on your own machine when developing (never in production)
FLASK_DEBUG=false
'@ | Set-Content -Path .env.example -Encoding utf8